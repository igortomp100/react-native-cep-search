{
  "expo": {
    "name": "Guardar CEP",
    "slug": "cep-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/guardar-cep-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#dce8ff",
        "foregroundImage": "./assets/brand/guardar-cep-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.guardarcep.app"
    },
    "web": {
      "favicon": "./assets/brand/guardar-cep-favicon.png"
    },
    "scheme": "cep-app",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o aplicativo use sua localização para encontrar um endereço e seu CEP.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/guardar-cep-splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#f6f8fc"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "73b90dde-ac65-4d79-bcb0-10c458f742ff"
      }
    }
  }
}
